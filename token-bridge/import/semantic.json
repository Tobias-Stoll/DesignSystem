{
  "$description": "Semantic layer. Every value is an alias to a primitive in the Figma collection 'Primitives'. Figma remains the source of truth.",
  "color": {
    "bg": {
      "default": {
        "$type": "color",
        "$value": "{color.base.white}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      }
    },
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.neutral.600}"
      },
      "subtle": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.base.white}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.neutral.200}"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.purple.500}"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "default": {
            "$type": "color",
            "$value": "{color.purple.600}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.purple.700}"
          },
          "pressed": {
            "$type": "color",
            "$value": "{color.purple.800}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.neutral.200}"
          }
        },
        "fg": {
          "$type": "color",
          "$value": "{color.base.white}"
        }
      },
      "secondary": {
        "bg": {
          "default": {
            "$type": "color",
            "$value": "{color.cyan.600}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.cyan.700}"
          },
          "pressed": {
            "$type": "color",
            "$value": "{color.cyan.800}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.neutral.200}"
          }
        },
        "fg": {
          "$type": "color",
          "$value": "{color.base.white}"
        }
      },
      "ghost": {
        "bg": {
          "default": {
            "$type": "color",
            "$value": "{color.base.transparent}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.purple.50}"
          },
          "pressed": {
            "$type": "color",
            "$value": "{color.purple.100}"
          }
        },
        "fg": {
          "$type": "color",
          "$value": "{color.purple.700}"
        }
      },
      "disabled": {
        "fg": {
          "$type": "color",
          "$value": "{color.neutral.400}"
        }
      }
    },
    "feedback": {
      "success": {
        "bg": {
          "$type": "color",
          "$value": "{color.green.50}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.green.700}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.green.300}"
        }
      },
      "warning": {
        "bg": {
          "$type": "color",
          "$value": "{color.amber.50}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.amber.700}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.amber.300}"
        }
      },
      "danger": {
        "bg": {
          "$type": "color",
          "$value": "{color.red.50}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.red.700}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.red.300}"
        }
      },
      "info": {
        "bg": {
          "$type": "color",
          "$value": "{color.blue.50}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.blue.700}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.blue.300}"
        }
      }
    }
  },
  "space": {
    "inset": {
      "xs": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.16}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.24}"
      }
    },
    "gap": {
      "xs": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "sm": {
        "$type": "dimension",
        "$value": "{space.8}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{space.12}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{space.16}"
      }
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "container": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "pill": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "indicator": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "input": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    }
  },
  "border-width": {
    "default": {
      "$type": "dimension",
      "$value": "{border-width.1}"
    },
    "focus": {
      "$type": "dimension",
      "$value": "{border-width.2}"
    }
  },
  "$textStyles": {
    "Display": {
      "family": "{font.family.display}",
      "weight": "{font.weight.bold}",
      "size": "{font.size.800}",
      "lineHeight": "{font.line-height.800}"
    },
    "Heading/L": {
      "family": "{font.family.display}",
      "weight": "{font.weight.medium}",
      "size": "{font.size.700}",
      "lineHeight": "{font.line-height.700}"
    },
    "Heading/M": {
      "family": "{font.family.display}",
      "weight": "{font.weight.medium}",
      "size": "{font.size.600}",
      "lineHeight": "{font.line-height.600}"
    },
    "Heading/S": {
      "family": "{font.family.display}",
      "weight": "{font.weight.medium}",
      "size": "{font.size.500}",
      "lineHeight": "{font.line-height.500}"
    },
    "Body/L": {
      "family": "{font.family.sans}",
      "weight": "{font.weight.regular}",
      "size": "{font.size.400}",
      "lineHeight": "{font.line-height.400}"
    },
    "Body/M": {
      "family": "{font.family.sans}",
      "weight": "{font.weight.regular}",
      "size": "{font.size.300}",
      "lineHeight": "{font.line-height.300}"
    },
    "Body/S": {
      "family": "{font.family.sans}",
      "weight": "{font.weight.regular}",
      "size": "{font.size.200}",
      "lineHeight": "{font.line-height.200}"
    },
    "Label": {
      "family": "{font.family.sans}",
      "weight": "{font.weight.medium}",
      "size": "{font.size.200}",
      "lineHeight": "{font.line-height.200}"
    },
    "Caption": {
      "family": "{font.family.sans}",
      "weight": "{font.weight.regular}",
      "size": "{font.size.100}",
      "lineHeight": "{font.line-height.100}"
    }
  }
}