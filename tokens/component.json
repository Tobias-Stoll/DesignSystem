{
  "button": {
    "primary": {
      "bg": {
        "default": {
          "$type": "color",
          "$value": "{color.action.primary.bg.default}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.action.primary.bg.hover}"
        },
        "pressed": {
          "$type": "color",
          "$value": "{color.action.primary.bg.pressed}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.action.primary.bg.disabled}"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.action.primary.fg}"
      }
    },
    "secondary": {
      "bg": {
        "default": {
          "$type": "color",
          "$value": "{color.action.secondary.bg.default}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.action.secondary.bg.hover}"
        },
        "pressed": {
          "$type": "color",
          "$value": "{color.action.secondary.bg.pressed}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.action.secondary.bg.disabled}"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.action.secondary.fg}"
      }
    },
    "ghost": {
      "bg": {
        "hover": {
          "$type": "color",
          "$value": "{color.action.ghost.bg.hover}"
        },
        "pressed": {
          "$type": "color",
          "$value": "{color.action.ghost.bg.pressed}"
        },
        "default": {
          "$type": "color",
          "$value": "{color.action.ghost.bg.default}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.action.ghost.bg.default}"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.action.ghost.fg}"
      }
    },
    "disabled": {
      "fg": {
        "$type": "color",
        "$value": "{color.action.disabled.fg}"
      }
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.inset.md}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{space.inset.sm}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.control}"
    },
    "focus-ring": {
      "color": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "width": {
        "$type": "dimension",
        "$value": "{border-width.focus}"
      }
    }
  },
  "input": {
    "bg": {
      "default": {
        "$type": "color",
        "$value": "{color.bg.default}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.bg.muted}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{color.border.default}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.border.strong}"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.border.focus}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.feedback.danger.fg}"
      }
    },
    "fg": {
      "default": {
        "$type": "color",
        "$value": "{color.fg.default}"
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.fg.muted}"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.fg.subtle}"
      }
    },
    "border-width": {
      "default": {
        "$type": "dimension",
        "$value": "{border-width.default}"
      },
      "focus": {
        "$type": "dimension",
        "$value": "{border-width.focus}"
      }
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{space.inset.md}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{space.inset.sm}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.input}"
    }
  }
}
